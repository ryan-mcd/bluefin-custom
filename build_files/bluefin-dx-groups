#!/usr/bin/env bash

GROUP_SETUP_VER=1
GROUP_SETUP_VER_FILE="/etc/ublue/dx-groups"
GROUP_SETUP_VER_RAN="$(cat "$GROUP_SETUP_VER_FILE" 2>/dev/null || true)"

mkdir -p /etc/ublue

if [[ -f "$GROUP_SETUP_VER_FILE" && "$GROUP_SETUP_VER" = "$GROUP_SETUP_VER_RAN" ]]; then
  echo "Group setup has already run. Exiting..."
  exit 0
fi

append_group() {
  local group_name="$1"
  if ! grep -q "^$group_name:" /etc/group; then
    echo "Appending $group_name to /etc/group"
    grep "^$group_name:" /usr/lib/group | tee -a /etc/group >/dev/null
  fi
}

agent_user="$(/usr/local/bin/bluefin-agent-user name 2>/dev/null || true)"

append_group incus-admin
append_group libvirt
if command -v docker >/dev/null 2>&1; then
  append_group docker
fi

readarray -t wheel_users < <(getent group wheel | cut -d ":" -f 4 | tr ',' '\n')
for user in "${wheel_users[@]}"; do
  if [[ -n "$user" ]]; then
    if [[ -n "$agent_user" && "$user" == "$agent_user" ]]; then
      echo "Skipping configured unprivileged agent user: $user"
      continue
    fi
    usermod -aG incus-admin "$user"
    usermod -aG libvirt "$user"
    if command -v docker >/dev/null 2>&1; then
      usermod -aG docker "$user"
    fi
  fi
done

echo "Writing state file"
echo "$GROUP_SETUP_VER" >"$GROUP_SETUP_VER_FILE"
