#!/usr/bin/env python3
"""Loopback-only control panel for the Bluefin agent account."""
import argparse
import hmac
import http.client
import json
import re
import secrets
import subprocess
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

ASSETS = Path('/usr/share/bluefin-agent/dashboard')
if not ASSETS.is_dir():
    ASSETS = Path(__file__).resolve().parent / 'dashboard'
PROFILES = {'disabled', 'model-only', 'central-agent', 'remote-agents', 'hybrid'}
KEYS = ('PROFILE', 'MODEL', 'MODEL_PORT', 'MODEL_CONTEXT_LENGTH', 'MODEL_GATEWAY_PORT', 'MODEL_GATEWAY_ACCESS', 'MODEL_GATEWAY_TLS')
SERVICES = {'Model runtime': 'bluefin-ramalama.service', 'Model gateway': 'bluefin-model-gateway.service', 'Hermes gateway': 'bluefin-hermes-gateway.service', 'Hermes API': 'bluefin-hermes-serve.service'}
job_lock = threading.Lock()
job = {'state': 'idle', 'output': '', 'action': ''}


def run(args, timeout=8):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=False)
        return result.returncode, (result.stdout + result.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)


def status():
    config = {}
    errors = []
    for key in KEYS:
        code, value = run(['bluefin-ai-profile', 'get', key])
        if code:
            errors.append(f'{key}: {value}')
        else:
            config[key] = value
    services = {}
    for label, unit in SERVICES.items():
        code, value = run(['systemctl', '--user', 'is-active', unit])
        services[label] = value if value in ('active', 'inactive', 'failed', 'activating', 'deactivating') else 'unknown'
    ready = False
    port = config.get('MODEL_PORT', '')
    if port.isdigit() and 1 <= int(port) <= 65535:
        connection = http.client.HTTPConnection('127.0.0.1', int(port), timeout=2)
        try:
            connection.request('GET', '/v1/models')
            ready = connection.getresponse().status == 200
        except (OSError, http.client.HTTPException):
            pass
        finally:
            connection.close()
    code, models = run(['ujust', 'ai-model-list'], timeout=15)
    with job_lock:
        current_job = dict(job)
    return {'config': config, 'services': services, 'ready': ready, 'models': models, 'models_error': bool(code), 'errors': errors, 'job': current_job}


def command_for(data):
    if not isinstance(data, dict):
        raise ValueError('Expected an object.')
    action = data.get('action')
    if action == 'model':
        model, context = data.get('model', ''), str(data.get('context', ''))
        if not isinstance(model, str) or len(model) > 500 or not re.fullmatch(r'[A-Za-z0-9._:/+\-]+', model):
            raise ValueError('Enter a valid RamaLama model reference.')
        if not re.fullmatch(r'[0-9]{1,8}', context) or int(context) < 1:
            raise ValueError('Context must be a positive integer.')
        code, profile = run(['bluefin-ai-profile', 'get', 'PROFILE'])
        if code:
            raise ValueError('Cannot read the current profile. Check the configuration before selecting a model.')
        if profile in ('central-agent', 'remote-agents', 'hybrid') and int(context) < 64000:
            raise ValueError('Agent profiles require a context of at least 64000 tokens.')
        return ['ujust', 'ai-model-select', model, context]
    if action == 'profile':
        profile = data.get('profile')
        if profile not in PROFILES:
            raise ValueError('Choose a valid profile.')
        return ['ujust', 'ai-profile-set', profile]
    if action == 'hermes':
        return ['ujust', 'ai-hermes-use-selected-model']
    raise ValueError('Unknown action.')


def start_job(command, action):
    with job_lock:
        if job['state'] == 'running':
            return False
        job.update(state='running', output='Starting…', action=action)
    def work():
        code, output = run(command, timeout=3600)
        with job_lock:
            job.update(state='succeeded' if code == 0 else 'failed', output=output[-20000:] or ('Completed.' if code == 0 else 'Command failed.'))
    threading.Thread(target=work, daemon=True).start()
    return True


class Handler(BaseHTTPRequestHandler):
    def allowed_host(self):
        return self.headers.get('Host') in (f'127.0.0.1:{self.server.server_port}', f'localhost:{self.server.server_port}')

    def authorized(self):
        supplied = self.headers.get('Authorization', '')
        expected = 'Bearer ' + self.server.capability
        return hmac.compare_digest(supplied.encode('utf-8'), expected.encode('utf-8'))

    def send(self, code, body, content_type):
        self.send_response(code)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Content-Security-Policy', "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'")
        self.end_headers()
        self.wfile.write(body)

    def json(self, code, value):
        self.send(code, json.dumps(value).encode(), 'application/json; charset=utf-8')

    def do_GET(self):
        if not self.allowed_host():
            return self.send_error(403)
        path = urlsplit(self.path).path
        if path == '/api/status':
            if not self.authorized():
                return self.json(401, {'error': 'Open the dashboard using the address printed in the terminal.'})
            return self.json(200, status())
        files = {'/': ('index.html', 'text/html; charset=utf-8'), '/app.js': ('app.js', 'text/javascript; charset=utf-8'), '/style.css': ('style.css', 'text/css; charset=utf-8')}
        if path not in files:
            return self.send_error(404)
        filename, mime = files[path]
        self.send(200, (ASSETS / filename).read_bytes(), mime)

    def do_POST(self):
        host = self.headers.get('Host', '')
        if not self.allowed_host() or self.headers.get('Origin') != f'http://{host}' or self.headers.get('Content-Type') != 'application/json':
            return self.send_error(403)
        if self.path != '/api/action':
            return self.send_error(404)
        if not self.authorized():
            return self.json(401, {'error': 'Open the dashboard using the address printed in the terminal.'})
        try:
            length = int(self.headers.get('Content-Length', '0'))
            if not 0 < length <= 4096:
                raise ValueError('Invalid request size.')
            data = json.loads(self.rfile.read(length))
            command = command_for(data)
        except (ValueError, TypeError, json.JSONDecodeError) as exc:
            return self.json(400, {'error': str(exc)})
        if not start_job(command, data['action']):
            return self.json(409, {'error': 'An operation is already running.'})
        self.json(202, {'ok': True})


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8765)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('port must be between 1 and 65535')
    code, output = run(['bluefin-agent-user', 'require'])
    if code:
        parser.exit(1, f'{output}\n')
    server = ThreadingHTTPServer(('127.0.0.1', args.port), Handler)
    server.capability = secrets.token_urlsafe(32)
    print(f'Bluefin AI dashboard: http://127.0.0.1:{args.port}/#{server.capability}', flush=True)
    print('Keep this address private: it grants control of the dashboard.', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == '__main__':
    main()
