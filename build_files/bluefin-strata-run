#!/usr/bin/env python3
"""Start the reviewed Strata image in the dedicated user's Podman session."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

IMAGE = 'ghcr.io/niko1221/strata:0.2.7-rocm-gfx1151'
QUANTS = frozenset(('Q2_0', 'IQ2_XS', 'IQ3_XXS', 'IQ3_S'))
BASE = Path.home() / '.config' / 'bluefin-ai' / 'strata'


def validate(settings):
    if not isinstance(settings, dict) or set(settings) != {'model', 'context', 'upstream_port', 'local_port'}:
        raise ValueError('invalid Strata runtime settings')
    if settings['model'] not in QUANTS:
        raise ValueError('unsupported Strata Qwen3.8-Flash-Next quantization')
    for field, maximum in (('context', 99999999), ('upstream_port', 65535), ('local_port', 65535)):
        value = settings[field]
        if type(value) is not int or not 1 <= value <= maximum:
            raise ValueError('invalid ' + field)
    if settings['local_port'] == settings['upstream_port']:
        raise ValueError('local and upstream ports must differ')
    return settings


def command(settings, key_file, render_node):
    validate(settings)
    if not re.fullmatch(r'/dev/dri/renderD[0-9]+', str(render_node)):
        raise ValueError('invalid render node')
    # Podman volume syntax uses ':' as a delimiter.
    if not key_file.is_absolute() or ':' in str(key_file) or '\n' in str(key_file):
        raise ValueError('unsupported key path')
    return ['podman', 'run', '--rm', '--replace', '--name', 'bluefin-strata',
            '--pull=missing', '--device', '/dev/kfd', '--device', str(render_node),
            '--group-add', 'keep-groups', '--cap-drop', 'all',
            '--security-opt', 'no-new-privileges', '--shm-size', '2g',
            '--stop-timeout', '120', '--publish',
            '127.0.0.1:%d:8080' % settings['upstream_port'],
            '--volume', 'bluefin-strata-data:/data',
            '--volume', str(key_file) + ':/run/bluefin/backend-key:ro,z',
            '--env', 'API_KEY_FILE=/run/bluefin/backend-key',
            '--env', 'FAMILY=qwen', '--env', 'MODEL=' + settings['model'],
            '--env', 'CONTEXT=' + str(settings['context']), IMAGE]


def main():
    subprocess.run(['bluefin-agent-user', 'require'], check=True)
    try:
        settings = validate(json.loads((BASE / 'runtime.json').read_text()))
        nodes = sorted(Path('/dev/dri').glob('renderD[0-9]*'))
        if len(nodes) != 1 or not Path('/dev/kfd').exists():
            raise ValueError('expected /dev/kfd and exactly one render node; inspect GPU access')
        args = command(settings, BASE / 'backend-key', nodes[0])
    except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
        sys.exit('Cannot start Strata: ' + str(exc))
    os.execvp(args[0], args)


if __name__ == '__main__':
    main()
