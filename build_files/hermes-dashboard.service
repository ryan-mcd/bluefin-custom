[Unit]
Description=Hermes Agent Dashboard in Bluefin Agent Distrobox
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.hermes/.env
ExecStart=/usr/bin/bluefin-hermes-run dashboard --host 0.0.0.0 --port 9119 --no-open
KillMode=mixed
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
