#!/usr/bin/env python3
"""Measure a repeatable streaming workload against the local model API."""
import argparse
import http.client
import json
import statistics
import sys
import time

PROMPT = ('Explain how to safely retry an interrupted file upload. '
          'Describe the protocol, integrity checks, and failure recovery in detail.')


def request(port, method, path, body=None):
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=3600)
    headers = {'Content-Type': 'application/json'} if body is not None else {}
    connection.request(method, path, body=body, headers=headers)
    response = connection.getresponse()
    if response.status != 200:
        response.read(4096)
        connection.close()
        raise RuntimeError(f'{path} returned HTTP {response.status}')
    return connection, response


def model_id(port):
    connection, response = request(port, 'GET', '/v1/models')
    try:
        body = json.loads(response.read(1048577))
        models = body.get('data', []) if isinstance(body, dict) else []
        if (not isinstance(models, list) or not models or not isinstance(models[0], dict) or
                not isinstance(models[0].get('id'), str) or not models[0]['id']):
            raise ValueError('endpoint returned no model ID')
        return models[0]['id']
    finally:
        connection.close()


def measure(port, model, max_tokens, clock=time.monotonic):
    body = json.dumps({'model': model, 'messages': [{'role': 'user', 'content': PROMPT}],
                       'stream': True, 'stream_options': {'include_usage': True},
                       'temperature': 0, 'max_tokens': max_tokens}).encode()
    started = clock()
    connection, response = request(port, 'POST', '/v1/chat/completions', body)
    first = last = usage = None
    done = False
    try:
        if 'text/event-stream' not in (response.getheader('Content-Type') or '').lower():
            raise ValueError('endpoint did not return an event stream')
        for raw in response:
            if not raw.startswith(b'data:'):
                continue
            data = raw[5:].strip()
            if data == b'[DONE]':
                done = True
                break
            if not data:
                continue
            item = json.loads(data)
            if not isinstance(item, dict):
                raise ValueError('invalid streaming event')
            if isinstance(item.get('usage'), dict):
                usage = item['usage']
            choices = item.get('choices', [])
            if not isinstance(choices, list):
                raise ValueError('invalid streaming choices')
            if any(isinstance(choice, dict) and isinstance(choice.get('delta'), dict)
                   and any(choice['delta'].get(field) for field in ('content', 'reasoning_content', 'tool_calls'))
                   for choice in choices):
                last = clock()
                if first is None:
                    first = last
        ended = clock()
        if not done or first is None:
            raise ValueError('stream ended without output or a completion marker')
        completion_tokens = usage.get('completion_tokens') if usage else None
        prompt_tokens = usage.get('prompt_tokens') if usage else None
        if type(completion_tokens) is not int or completion_tokens < 1:
            completion_tokens = None
        if type(prompt_tokens) is not int or prompt_tokens < 0:
            prompt_tokens = None
        decode_seconds = last - first
        rate = completion_tokens / decode_seconds if completion_tokens and decode_seconds > 0 else None
        return {'time_to_first_output_s': round(first - started, 3),
                'total_s': round(ended - started, 3), 'prompt_tokens': prompt_tokens,
                'completion_tokens': completion_tokens,
                'approx_output_tokens_per_s': round(rate, 2) if rate is not None else None}
    finally:
        connection.close()


def bounded_int(minimum, maximum):
    def parse(value):
        if not value.isdecimal() or not minimum <= int(value) <= maximum:
            raise argparse.ArgumentTypeError(f'must be between {minimum} and {maximum}')
        return int(value)
    return parse


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=bounded_int(1, 65535), default=8080)
    parser.add_argument('--runs', type=bounded_int(1, 10), default=3)
    parser.add_argument('--max-tokens', type=bounded_int(1, 4096), default=128)
    args = parser.parse_args()
    try:
        model = model_id(args.port)
        print(f'Model reported by endpoint: {model}', flush=True)
        print('Using a fixed prompt; compare the same quantization, context and settings.', flush=True)
        runs = []
        for number in range(1, args.runs + 1):
            result = measure(args.port, model, args.max_tokens)
            runs.append(result)
            print(f'Run {number}: {json.dumps(result)}', flush=True)
        rates = [run['approx_output_tokens_per_s'] for run in runs if run['approx_output_tokens_per_s'] is not None]
        print('Median time to first output: %.3f s' % statistics.median(run['time_to_first_output_s'] for run in runs))
        if rates:
            print('Median approximate output rate: %.2f tokens/s' % statistics.median(rates))
            print('Approximation uses reported completion tokens and time between first and last output events.')
        else:
            print('Output rate unavailable: the endpoint did not report completion token usage.')
    except (OSError, ValueError, RuntimeError, http.client.HTTPException) as exc:
        print(f'Benchmark failed: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
