{
  "notice": "Authoring examples only. Images resolve through the Dependabot-managed Dockerfile. Supply verified model artifacts and validate each startup command on the target GPU. Strata still needs a verified-model adapter.",
  "llamacpp-vulkan": {
    "engine": "llamacpp",
    "image": "image:llamacpp",
    "accelerator": "vulkan",
    "requires_key": true,
    "backend_model": "general-backend",
    "port": 18110,
    "resident_gib": 8,
    "command": [
      "--host",
      "0.0.0.0",
      "--port",
      "8080",
      "--model",
      "/models/model.gguf",
      "--alias",
      "general-backend",
      "--ctx-size",
      "8192",
      "--parallel",
      "2",
      "--n-gpu-layers",
      "99",
      "--api-key-file",
      "/run/bluefin-key"
    ],
    "artifacts": [
      {
        "name": "model.gguf",
        "sha256": null,
        "bytes": null
      }
    ]
  },
  "ramalama-vulkan": {
    "engine": "ramalama",
    "image": "image:ramalama",
    "accelerator": "vulkan",
    "requires_key": true,
    "backend_model": "ramalama-backend",
    "port": 18111,
    "resident_gib": 8,
    "command": [
      "llama-server",
      "--host",
      "0.0.0.0",
      "--port",
      "8080",
      "--model",
      "/models/model.gguf",
      "--alias",
      "ramalama-backend",
      "--ctx-size",
      "8192",
      "--parallel",
      "2",
      "--n-gpu-layers",
      "99",
      "--api-key-file",
      "/run/bluefin-key"
    ],
    "artifacts": [
      {
        "name": "model.gguf",
        "sha256": null,
        "bytes": null
      }
    ]
  },
  "strata-rocm": {
