  "vllm-rocm": {
    "engine": "vllm",
    "image": "image:vllm",
    "accelerator": "rocm",
    "requires_key": true,
    "backend_model": "coding-backend",
    "port": 18113,
    "resident_gib": 24,
    "command": [
      "--host",
      "0.0.0.0",
      "--port",
      "8080",
