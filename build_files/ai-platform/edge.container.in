[Unit]
Description=Authenticated inference-only ingress for Bifrost
Requires=bluefin-platform-bifrost.service
After=bluefin-platform-bifrost.service
PartOf=bluefin-ai-platform.target

[Container]
Image=@@IMAGE@@
ContainerName=bluefin-platform-edge
User=0
Network=host
# Entrypoint= needs a newer Quadlet parser; this flag also works with Podman 4.9.
PodmanArgs=--entrypoint /usr/sbin/nginx
Exec=-c /etc/nginx/bluefin.conf -g "daemon off;"
Volume=%h/.config/bluefin-ai/platform/nginx.conf:/etc/nginx/bluefin.conf:ro,Z
ReadOnly=true
Tmpfs=/tmp:rw,nodev,nosuid,noexec,size=32m
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
MemoryMax=256M
