def run(*args, timeout=1800):
    try:
        return subprocess.run(args, check=True, capture_output=True, text=True, timeout=timeout)
    except subprocess.CalledProcessError as exc:
        # stderr contains the actionable Podman/systemd error; stdout may contain
        # private container inspection data and must not be copied to the journal.
        detail = (exc.stderr or '').strip()
        message = f'Command failed (exit {exc.returncode}): {shlex.join(args)}'
        if detail:
            message += '\n' + detail[-4000:]
        raise RuntimeError(message) from exc
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f'Command timed out after {timeout}s: {shlex.join(args)}') from exc


def active(unit):
    result = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', unit],
                            check=False, capture_output=True, text=True, timeout=15)
    if result.returncode not in (0, 3, 4):
        raise RuntimeError('Cannot inspect user service ' + unit + ': ' + result.stderr.strip())
    return result.returncode == 0


def reset_failed(*units):
    # ResetFailedUnit does not load inactive units. Fresh Quadlets may exist on
    # disk without being loaded into the manager yet; resetting them aborts boot.
    result = run('systemctl', '--user', 'list-units', '--failed', '--no-legend',
                 '--plain', '--no-pager', *units)
    failed = {line.split()[0] for line in result.stdout.splitlines() if line.split()}
    selected = [unit for unit in units if unit in failed]
    if selected:
        run('systemctl', '--user', 'reset-failed', *selected)


def ensure_images(config, *, runtimes=True):
    """Immutable cached images support offline boots; pull only missing digests."""
    images = list(config['images'].values())
    if runtimes:
        images += [p['image'] for p in config['profiles'].values()]
    for image in dict.fromkeys(images):
        result = subprocess.run(['podman', 'image', 'exists', image], check=False,
                                capture_output=True, text=True, timeout=30)
        if result.returncode == 1:
            run('podman', 'pull', image)
        elif result.returncode != 0:
            raise RuntimeError('Cannot inspect cached image ' + image + ': ' + result.stderr.strip())


def probe(port, path, credential=None):
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=3)
    try:
        headers = {'Authorization': 'Bearer ' + credential} if credential else {}
        connection.request('GET', path, headers=headers)
        response = connection.getresponse()
        body = response.read(1024 * 1024 + 1)
        if len(body) > 1024 * 1024:
            raise RuntimeError('Oversized readiness response from ' + str(port))
        return response.status, body
    finally:
        connection.close()


def verify_platform(config, timeout=180):
    """A started unit alone does not prove the desired images or APIs are ready."""
    expected_models = {'local/' + alias for alias in config['aliases']}
    expected = {}
    for name in ('bifrost', 'webui', 'edge'):
        try:
            metadata = json.loads(run('podman', 'image', 'inspect', config['images'][name], timeout=15).stdout)
            image_id = metadata[0]['Id']
            if not isinstance(image_id, str) or not re.fullmatch(r'(sha256:)?[0-9a-f]{64}', image_id):
                raise ValueError('Invalid image ID')
            expected['bluefin-platform-' + name] = image_id.removeprefix('sha256:')
        except (ValueError, KeyError, IndexError, TypeError) as exc:
            raise RuntimeError('Invalid cached image metadata for ' + name) from exc
    admin_key, client_key = key('admin-key'), key('client-key')
    deadline = time.monotonic() + timeout
    while True:
        try:
            containers = json.loads(run('podman', 'container', 'inspect', *expected, timeout=15).stdout)
            actual = {entry['Name'].lstrip('/'): entry for entry in containers}
            for name, image_id in expected.items():
                container = actual.get(name, {})
                if (not container.get('State', {}).get('Running') or
                        container.get('Image', '').removeprefix('sha256:') != image_id):
                    raise RuntimeError(name + ' is not running its configured image; stop the target before repair')
            status, body = probe(18100, '/control/status', admin_key)
            if status != 200 or json.loads(body).get('state') not in ('idle', 'ready', 'starting', 'draining', 'stopping'):
                raise RuntimeError('Runtime controller is not ready')
            status, body = probe(3001, '/health')
            if status != 200 or json.loads(body).get('status') is not True:
                raise RuntimeError('Open WebUI backend health check failed')
            status, body = probe(3000, '/health')
            if status != 200 or json.loads(body).get('status') is not True:
                raise RuntimeError('Open WebUI ingress health check failed')
            status, body = probe(18101, '/v1/models')
            if status != 200 or not expected_models.issubset({m['id'] for m in json.loads(body).get('data', [])}):
                raise RuntimeError('Bifrost model listing is missing configured aliases')
            status, _ = probe(8643, '/v1/models')
            if status != 401:
                raise RuntimeError('Inference gateway did not require authentication')
            status, body = probe(8643, '/v1/models', client_key)
            data = json.loads(body).get('data')
            if status != 200 or not isinstance(data, list):
                raise RuntimeError('Authenticated inference gateway model discovery failed')
            return
        except (OSError, ValueError, KeyError, IndexError, TypeError, AttributeError, RuntimeError,
                http.client.HTTPException, subprocess.SubprocessError) as exc:
            if time.monotonic() >= deadline:
                raise RuntimeError('Platform readiness failed: ' + str(exc)) from exc
            time.sleep(2)


def load():
    override = Path('/etc/bluefin-ai/platform.json')
    return resolve_images(json.loads((override if override.exists() else ASSETS / 'platform.json').read_text()))


def image_catalog(manifest=None):
    """Read the dependency bot's Dockerfile without executing build instructions."""
    manifest = manifest or ASSETS / 'Dockerfile'
    images = {}
    for number, line in enumerate(manifest.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        match = re.fullmatch(r'FROM ([a-z0-9./:_-]+@sha256:[0-9a-f]{64}) AS ([a-z][a-z0-9-]*)', line)
        if not match or match[2] in images or ':' not in match[1].split('@')[0].rsplit('/', 1)[-1]:
            raise ValueError(f'Invalid or duplicate image declaration at {manifest}:{number}')
        images[match[2]] = match[1]
    if set(images) != COMPONENTS:
        raise ValueError('Image catalog must define exactly: ' + ', '.join(sorted(COMPONENTS)))
    return images


def podman_reference(image):
    """containers/image on older hosts accepts digest-only, not tag@digest."""
    if not isinstance(image, str) or '@sha256:' not in image:
        return image
    repository, checksum = image.split('@', 1)
    if ':' in repository.rsplit('/', 1)[-1]:
        repository = repository.rsplit(':', 1)[0]
    return repository + '@' + checksum


def resolve_images(config, manifest=None):
    """Resolve image:<component> using the single Dependabot-managed catalog."""
    catalog = None

    def resolve(value):
        nonlocal catalog
        if isinstance(value, str) and value.startswith('image:'):
            if catalog is None:
                catalog = image_catalog(manifest)
            name = value.removeprefix('image:')
            if name not in catalog:
                raise ValueError('Unknown image catalog component: ' + name)
            return podman_reference(catalog[name])
        return podman_reference(value)

    result = dict(config)
    result['images'] = {name: resolve(value) for name, value in config.get('images', {}).items()}
    result['runtime_images'] = {name: resolve(value) for name, value in config.get('runtime_images', {}).items()}
    result['profiles'] = {name: dict(profile, image=resolve(profile['image']))
                          for name, profile in config.get('profiles', {}).items()}
    return result


def scalar(value):
    if not isinstance(value, str) or not value or any(c in value for c in '\n\r\0%$'):
        raise ValueError('Invalid configuration string (control characters, % and $ are unsupported)')
    return value


def digest(value):
    if not isinstance(value, str) or not re.fullmatch(r'[a-z0-9./:_-]+@sha256:[0-9a-f]{64}', value):
        raise ValueError('Every enabled container requires a fully qualified image@sha256:digest')


def validate(config):
    if type(config.get('enabled')) is not bool:
        raise ValueError('enabled must be a boolean')
    if not config['enabled']:
        return config
    for name in ('bifrost', 'webui', 'edge'):
        digest(config['images'][name])
    for name, low, high in (('reserve_gib', 12, 32), ('max_inflight', 1, 8),
                            ('startup_seconds', 10, 900), ('drain_seconds', 1, 120),
                            ('idle_seconds', 30, 86400)):
        if type(config[name]) is not int or not low <= config[name] <= high:
            raise ValueError('Invalid ' + name)
    for name, low, high, default in (('max_pending', 0, 16, 8), ('queue_seconds', 1, 300, 180)):
        if type(config.get(name, default)) is not int or not low <= config.get(name, default) <= high:
            raise ValueError('Invalid ' + name)
    if len(config['profiles']) > 4096 or not config['aliases']:
        raise ValueError('Provide at most 4096 installed runtime profiles and at least one alias')
    for image in config.get('runtime_images', {}).values():
        digest(image)
    for field, choices in (('prepare_on_boot', config['profiles']), ('webui_aliases', config['aliases'])):
        if field in config and (not isinstance(config[field], list) or
                any(not isinstance(name, str) or name not in choices for name in config[field])):
            raise ValueError('Invalid ' + field)
    if 'general' not in config['aliases']:
        raise ValueError('Provide a general alias for the platform-selected default')
    ports = set()
    declared_artifacts = {}
    for name, profile in config['profiles'].items():
        if not re.fullmatch(r'[a-z][a-z0-9-]{0,31}', name):
            raise ValueError('Invalid profile name')
        if profile['engine'] not in ('ramalama', 'llamacpp', 'strata', 'vllm'):
            raise ValueError('Unsupported engine')
        digest(profile['image'])
        scalar(profile['backend_model'])
        if type(profile['port']) is not int or not 18110 <= profile['port'] <= 18199 or (profile['port'] in ports and not profile.get('source')):
            raise ValueError('Use unique runtime ports in 18110-18199')
        ports.add(profile['port'])
        if type(profile.get('force_memory', False)) is not bool:
            raise ValueError('force_memory must be a boolean')
        if (type(profile['resident_gib']) is not int or profile['resident_gib'] < 1 or
                (profile['resident_gib'] > 110 and not profile.get('force_memory', False))):
            raise ValueError('resident_gib must bound weights + KV + runtime overhead')
        if profile['accelerator'] not in ('vulkan', 'rocm') or type(profile['requires_key']) is not bool:
            raise ValueError('Set accelerator and requires_key explicitly')
        if not isinstance(profile['command'], list):
            raise ValueError('command must be an argument array')
        for value in profile['command']:
            scalar(value)
        if profile.get('entrypoint') is not None:
            scalar(profile['entrypoint'])
        for key, value in profile.get('environment', {}).items():
            if not re.fullmatch(r'[A-Z][A-Z0-9_]*', key):
                raise ValueError('Invalid environment name')
            scalar(value)
        if profile.get('hub_cache') is not None and (not isinstance(profile['hub_cache'], str) or not Path(profile['hub_cache']).is_absolute()):
            raise ValueError('hub_cache must be an absolute local path')
        if profile.get('model_directory') is not None and not re.fullmatch(r'hf-[0-9a-f]{20}', profile['model_directory']):
            raise ValueError('Invalid model directory')
        if 'cache_volume' in profile and (not isinstance(profile['cache_volume'], str) or
                not re.fullmatch(r'bluefin-[a-z0-9-]{1,63}', profile['cache_volume'])):
            raise ValueError('Use a bluefin-prefixed named cache volume')
        if 'context_tokens' in profile and (type(profile['context_tokens']) is not int or
                not 1 <= profile['context_tokens'] <= 262144):
            raise ValueError('context_tokens must be between 1 and 262144')
        if 'context_tokens' in profile:
            if profile['engine'] in ('llamacpp', 'ramalama'):
                command = profile['command']
                try:
                    total = int(command[command.index('--ctx-size') + 1])
                    slots = int(command[command.index('--parallel') + 1])
                except (ValueError, IndexError) as exc:
                    raise ValueError('Declare numeric --ctx-size and --parallel for context_tokens') from exc
                if slots < 1 or total != slots * profile['context_tokens']:
                    raise ValueError('Runtime context/slots do not match context_tokens')
            elif profile['engine'] == 'strata':
                if profile.get('environment', {}).get('CONTEXT') != str(profile['context_tokens']):
                    raise ValueError('Strata CONTEXT does not match context_tokens')
        if not profile['artifacts']:
            raise ValueError('Declare immutable model artifacts')
        for artifact in profile['artifacts']:
            relative_name(artifact['name'])
            if not re.fullmatch(r'[0-9a-f]{64}', artifact['sha256']):
                raise ValueError('Model artifact SHA256 required')
            if type(artifact['bytes']) is not int or not 1 <= artifact['bytes'] <= 500 * 1024 ** 3:
                raise ValueError('Declare model artifact size in bytes')
            identity = (artifact['sha256'], artifact['bytes'])
            if artifact['name'] in declared_artifacts and declared_artifacts[artifact['name']] != identity:
                raise ValueError('Conflicting metadata for shared artifact: ' + artifact['name'])
            declared_artifacts[artifact['name']] = identity
            if artifact.get('url'):
                url = urllib.parse.urlsplit(artifact['url'])
                if url.scheme != 'https' or not url.hostname or url.username or url.password:
                    raise ValueError('Model download URL must be HTTPS without embedded credentials')
    for alias, target in config['aliases'].items():
        if not re.fullmatch(r'[a-z][a-z0-9-]{0,63}', alias) or (target not in config['profiles'] and not (alias == 'general' and target is None)):
            raise ValueError('Alias must identify a configured profile')
    return config


def write(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.platform-')
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(value)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def key(name):
    path = BASE / name
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        if (path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o077 or
                path.stat().st_uid != os.getuid()):
            raise ValueError('Existing secret must be a private regular file: ' + name)
        value = path.read_text().strip()
        if not re.fullmatch(r'[0-9a-f]{64}', value):
            raise ValueError('Invalid existing secret: ' + name)
        return value
    value = secrets.token_hex(32)
    with os.fdopen(fd, 'w') as stream:
        stream.write(value + '\n')
    return value


def runtime_quadlet(name, p):
    # Use run flags for compatibility with Ubuntu 24.04's Podman 4.9 Quadlet parser.
    devices = 'AddDevice=/dev/dri\nPodmanArgs=--group-add=keep-groups\n'
    if p['accelerator'] == 'rocm':
        devices += 'AddDevice=/dev/kfd\n'
    env = ''.join('Environment=' + json.dumps(k + '=' + v) + '\n'
                  for k, v in p.get('environment', {}).items())
    entrypoint = 'PodmanArgs=--entrypoint ' + json.dumps(p['entrypoint']) + '\n' if p.get('entrypoint') else ''
    cache_volume = p.get('cache_volume', f'bluefin-runtime-{name}-cache')
    shared_memory = 'PodmanArgs=--shm-size=2g\n' if p['engine'] == 'strata' else ''
    directory = p.get('model_directory')
    model_mount = ('Volume=%h/.local/share/bluefin-ai/models/' + directory + ':/models/' + directory + ':ro,z\n'
                   if directory else 'Volume=%h/.local/share/bluefin-ai/models:/models:ro,z\n')
    return (f'[Unit]\nDescription=Managed {p["engine"]} runtime {name}\n'
            '[Container]\n' + f'Image={p["image"]}\nContainerName=bluefin-runtime-{name}\nUser=0\n'
            f'PublishPort=127.0.0.1:{p["port"]}:8080\n' + devices + env + entrypoint + shared_memory +
            'EnvironmentFile=%h/.config/bluefin-ai/platform/engine.env\n'
            + model_mount +
            'Volume=%h/.config/bluefin-ai/platform/inference-key:/run/bluefin-key:ro,z\n'
            f'Volume={cache_volume}:/data\n'
            'DropCapability=all\nNoNewPrivileges=true\n'
            'Exec=' + ' '.join(json.dumps(a) for a in p['command']) + '\n'
            '[Service]\nRestart=no\nTimeoutStartSec=120\nTimeoutStopSec=120\n'
            f'MemoryMax={p["resident_gib"] + 2}G\n')


def verify_model_file(path, artifact):
    if path.stat().st_size != artifact['bytes']:
        raise ValueError('Model size mismatch: ' + artifact['name'])
    before = path.stat()
    hasher = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b''):
            hasher.update(block)
    if hasher.hexdigest() != artifact['sha256']:
        raise ValueError('Model checksum mismatch: ' + artifact['name'] +
                         '; verify/repair the HF cache with hf cache verify or hf download --force-download')
    after = path.stat()
    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
    if any(getattr(before, field) != getattr(after, field) for field in fields):
        raise ValueError('Model changed during verification: ' + artifact['name'])


def model_artifact(models, artifact, cache_dir=None):
    """Verify existing bytes or publish a view of an official HF cache file."""
    models.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = model_path(models, artifact['name'])
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not path.exists():
        cached = download_artifact(artifact, cache_dir).resolve(strict=True)
        fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.model-stage-')
        os.close(fd)
        try:
            os.unlink(temporary)
            try:
                os.link(cached, temporary)
            except OSError as exc:
                if exc.errno != errno.EXDEV:
                    raise
                if shutil.disk_usage(path.parent).free < artifact['bytes'] + 8 * 1024 ** 3:
                    raise ValueError('Serving directory needs space for a cross-filesystem copy plus 8 GiB reserve') from exc
                shutil.copyfile(cached, temporary)
            verify_model_file(Path(temporary), artifact)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    else:
        # Preserve already downloaded/preseeded models; no mandatory re-download.
        verify_model_file(path, artifact)
    after = path.stat()
    receipt = dict(name=artifact['name'], sha256=artifact['sha256'], bytes=artifact['bytes'],
                   stat=[getattr(after, field) for field in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns')])
    receipt_id = hashlib.sha256((artifact['name'] + ':' + artifact['sha256']).encode()).hexdigest()
    write(models / '.verified' / (receipt_id + '.json'), json.dumps(receipt) + '\n')


def provision(config):
    if not config['enabled']:
        print('AI platform disabled in image release configuration')
        return
    run('bluefin-agent-user', 'require')
    for unit in LEGACY:
        if active(unit):
            raise ValueError('Disable legacy AI profile before enabling the platform: ' + unit)
    migrate_installed_profiles(config)
    release_config = config
    config = validate(merge_registry(config, BASE))
    fingerprint = hashlib.sha256(json.dumps(release_config, sort_keys=True).encode())
    for path in sorted(ASSETS.iterdir()):
        if path.is_file():
            fingerprint.update(path.name.encode())
            fingerprint.update(path.read_bytes())
    release = fingerprint.hexdigest()
    unchanged = (BASE / 'release').exists() and (BASE / 'release').read_text().strip() == release
    # Only a stopped platform can be reconciled. Prevent mixed old/new releases.
    if active('bluefin-ai-platform.target'):
        if not unchanged:
            raise ValueError('Stop bluefin-ai-platform.target before reprovisioning')
        verify_platform(config)
        print('Current platform release is running with verified images and API health')
        return
    for unit in SERVICES:
        if active(unit):
            raise ValueError('Managed service is running outside its target; stop it before repair: ' + unit)
    # The UI/control plane must not wait on GPU tuning or model downloads.
    # A separate user service prepares models and engine images after startup.
    ensure_images(config, runtimes=False)
    BASE.mkdir(mode=0o700, parents=True, exist_ok=True)
    inference, client = key('inference-key'), key('client-key')
    key('admin-key')
    webui_secret, admin_password = key('webui-secret'), key('webui-admin-password')
    write(BASE / 'bifrost.env', 'CONTROLLER_API_KEY=' + inference + '\n')
    write(BASE / 'engine.env', 'VLLM_API_KEY=' + inference + '\n')
    # Empty model_ids enables provider discovery instead of a static UI allowlist.
    webui_connections = json.dumps({'0': {'enable': True, 'prefix_id': '', 'model_ids': []}})
    write(BASE / 'webui.env', 'WEBUI_SECRET_KEY=' + webui_secret + '\nWEBUI_ADMIN_EMAIL=admin@example.com\n'
          'WEBUI_ADMIN_PASSWORD=' + admin_password + '\nOPENAI_API_KEYS=' + client +
          '\nOPENAI_API_CONFIGS=' + webui_connections + '\n')
    write(BASE / 'bifrost.json', (ASSETS / 'bifrost.json').read_text())
    write(BASE / 'nginx-sources.conf', (ASSETS / 'nginx-sources.conf').read_text())
    write(BASE / 'nginx.conf', (ASSETS / 'nginx.conf.in').read_text().replace('@@CLIENT_KEY@@', client).replace('@@INFERENCE_KEY@@', inference))
    write(BASE / 'controller.json', json.dumps(release_config, indent=2) + '\n')
    quadlets = Path.home() / '.config/containers/systemd'
    # Remove profiles from a prior stopped release, without touching legacy files.
    for path in quadlets.glob('bluefin-runtime-*.container'):
        path.unlink()
    for name in ('bifrost', 'webui', 'edge'):
        template = (ASSETS / (name + '.container.in')).read_text()
        write(quadlets / ('bluefin-platform-' + name + '.container'),
              template.replace('@@IMAGE@@', config['images'][name]))
    for name, profile in config['profiles'].items():
        write(quadlets / ('bluefin-runtime-' + name + '.container'), runtime_quadlet(name, profile))
    run('systemctl', '--user', 'daemon-reload')
    reset_failed(*SERVICES, 'bluefin-ai-models.service')
    try:
        run('systemctl', '--user', 'start', 'bluefin-ai-platform.target')
        verify_platform(config)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        try:
            run('systemctl', '--user', 'stop', 'bluefin-ai-platform.target')
        except (OSError, subprocess.SubprocessError) as cleanup:
            raise RuntimeError('Startup failed and target cleanup failed: ' + str(cleanup)) from exc
        raise
    write(BASE / 'release', release + '\n')
    print('Platform reconciled: desired container images, WebUI and APIs verified. Private credentials: ' + str(BASE))


def prepare_models(profiles=None):
    run('bluefin-agent-user', 'require')
    config = effective_config()
    models = Path.home() / '.local/share/bluefin-ai/models'
    manager = model_manager(config)
    names = manager.boot_profiles() if profiles is None else profiles
    verified = set()
    for name in names:
        profile = config['profiles'][name]
        cache = cache_directory(profile)
        records = registry_profiles(BASE)
        if name in records and not records[name].get('hub_cache'):
            records[name] = dict(records[name], hub_cache=str(cache))
            write(BASE / 'model-registry.json', json.dumps(dict(version=1, profiles=records)) + '\n')
        ensure_images({'images': {}, 'profiles': {name: profile}})
        for artifact in profile['artifacts']:
            identity = (artifact['name'], artifact['sha256'])
            if identity not in verified:
                model_artifact(models, artifact, cache_dir=cache)
                verified.add(identity)
        print('Prepared runtime/model profile: ' + name, flush=True)
    print('Requested model artifacts verified and runtime images available')


@contextlib.contextmanager
def model_lock():
    with (BASE / 'models.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ValueError('Model preparation is running; retry after it finishes') from exc
        yield


def effective_config():
    return validate(merge_registry(json.loads((BASE / 'controller.json').read_text()), BASE))


def migrate_installed_profiles(config):
    path = BASE / 'controller.json'
    if not path.exists():
        return
    previous = json.loads(path.read_text())
    manager = model_manager(previous)
    wanted = manager.installed()
    selected = selected_profile(previous, BASE, saved_only=True)
    if selected:
        wanted.add(selected)
    profiles = registry_profiles(BASE)
    for name in wanted:
        if name not in config['profiles'] and name in previous['profiles'] and name not in profiles:
            profiles[name] = previous['profiles'][name]
    if profiles:
        write(BASE / 'model-registry.json', json.dumps(dict(version=1, profiles=profiles)) + '\n')


def save_profile(name, profile):
    profiles = registry_profiles(BASE)
    if name in profiles and {key:value for key,value in dict(profiles[name], image=profile['image']).items() if key != 'hub_cache'} != {key:value for key,value in profile.items() if key != 'hub_cache'}:
        raise ValueError('Installed profile differs; remove it before replacing it')
    profile = dict(profile, hub_cache=profiles.get(name, {}).get('hub_cache') or str(cache_directory(profile)))
    profiles[name] = profile
    config = json.loads((BASE / 'controller.json').read_text())
    validate(dict(config, profiles={**config['profiles'], **profiles}))
    write(BASE / 'model-registry.json', json.dumps(dict(version=1, profiles=profiles)) + '\n')
    quadlets = Path.home() / '.config/containers/systemd'
    write(quadlets / ('bluefin-runtime-' + name + '.container'), runtime_quadlet(name, profile))
    run('systemctl', '--user', 'daemon-reload')


def model_manager(config):
    return ModelManager(config, BASE, Path.home() / '.local/share/bluefin-ai/models', run, write)


def parse_context(value):
    if not re.fullmatch(r'[1-9][0-9]*[kK]?', value):
        raise argparse.ArgumentTypeError('Use a token count or a context such as 64k or 128k')
    return int(value[:-1]) * 1024 if value.lower().endswith('k') else int(value)


def manage_models(args):
    run('bluefin-agent-user', 'require')
    if not (BASE / 'controller.json').exists():
        raise ValueError('Platform is not provisioned; inspect the boot service before managing models')
    config = effective_config()
    manager = model_manager(config)
    action = args.model_action
    if action == 'list':
        manager.list_models()
    elif action == 'status':
        print(json.dumps(manager.control(), indent=2))
    elif action in ('auto', 'unload', 'clear'):
        print(json.dumps(manager.control(action), indent=2))
    elif action in ('inspect', 'plan', 'fetch'):
        existing = config['profiles'].get(args.source)
        if existing:
            if args.revision or args.file or args.format != 'auto':
                raise ValueError('Supply a Hugging Face source to change its revision, file or format')
            source = existing.get('source')
            name, profile = args.source, existing
            if action != 'inspect' and (args.context is not None or args.runtime != 'auto' or args.memory_gib is not None or args.force):
                if source is None:
                    raise ValueError('Re-fetch a Hugging Face source to change legacy model settings')
                name, profile = make_profile(source, config['runtime_images'],
                                             existing['engine'] if args.runtime == 'auto' else args.runtime,
                                             args.context or existing.get('context_tokens'), args.memory_gib,
                                             force=args.force or existing.get('force_memory', False))
        else:
            source = resolve_source(args.source, args.revision, args.file, format=args.format)
            if action != 'inspect':
                name, profile = make_profile(source, config.get('runtime_images', {}), args.runtime, args.context, args.memory_gib,
                                             force=args.force)
        if action == 'inspect':
            print(json.dumps(source or existing, indent=2))
            return
        proposed = dict(config, profiles={**config['profiles'], name: profile})
        validate(proposed)
        print('Installed model ID: ' + name)
        if source:
            print('Source: ' + source['repo'] + '@' + source['revision'])
            print('Format: ' + source['format'] + '; architecture: ' + str(source['architecture']))
        print('Runtime: ' + profile['engine'] + (' (RamaLama-packaged llama.cpp)' if profile['engine'] == 'ramalama' else ''))
        model_manager(proposed).plan([name])
        if action == 'fetch':
            with model_lock():
                if name not in json.loads((BASE / 'controller.json').read_text())['profiles']:
                    save_profile(name, profile)
                updated = effective_config()
                model_manager(updated).remember(manager.installed() | {name})
                prepare_models([name])
                model_manager(updated).control('reload')
            print('Available in Open WebUI: refresh the page and select the model by its source name.')
            print('Optional platform default: bluefin-ai-platform models use ' + name)
    else:
        name = manager.resolve(args.model)
        if action in ('use', 'pin'):
            profile = config['profiles'][name]
            requested_runtime = args.runtime
            requested_context = args.context
            if requested_context is not None or requested_runtime != 'auto' or args.memory_gib is not None or args.force:
                if not profile.get('source'):
                    raise ValueError('Re-fetch a Hugging Face source to change legacy model settings')
                engine = profile['engine'] if requested_runtime == 'auto' else requested_runtime
                name, profile = make_profile(profile['source'], config['runtime_images'], engine,
                                             requested_context or profile.get('context_tokens'), args.memory_gib,
                                             force=args.force or profile.get('force_memory', False))
                with model_lock():
                    save_profile(name, profile)
                    prepare_models([name])
                    model_manager(effective_config()).control('reload')
            warn_forced_memory(profile)
            print(json.dumps(manager.control('select' if action == 'use' else 'select-pin', name), indent=2))
            print('WebUI and other clients can keep using local/general.')
        elif action == 'remove':
            print(json.dumps(manager.control('remove', name, args.purge_cache), indent=2))
            print('Removed installation and unshared weights; prepared caches ' + ('purged where unshared.' if args.purge_cache else 'retained.'))


def show_status():
    """Rootless containers must be inspected in their owner's user manager."""
    config_path = Path('/etc/bluefin-ai/platform.json')
    if not config_path.exists():
        config_path = ASSETS / 'platform.json'
    print('Effective configuration: ' + str(config_path), flush=True)
    print('Enabled: ' + str(json.loads(config_path.read_text()).get('enabled')), flush=True)
    name = run('bluefin-agent-user', 'name').stdout.strip()
    account = pwd.getpwnam(name)
    uid = account.pw_uid
    credential_path = Path(account.pw_dir) / '.config/bluefin-ai/platform/client-key'
    print('Rootless service account: ' + name, flush=True)
    if os.geteuid() == 0:
        subprocess.run(['systemctl', '--no-pager', '--full', 'status',
                        'bluefin-ai-platform-boot.service', 'bluefin-ai-memory.service'], check=False)
        prefix = ['runuser', '-u', name, '--', 'env']
    elif os.getuid() == uid:
        prefix = ['env']
    else:
        print('Use sudo bluefin-ai-platform status to inspect that account.')
        return
    prefix += ['XDG_RUNTIME_DIR=/run/user/' + str(uid),
               'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/' + str(uid) + '/bus']
    subprocess.run(prefix + ['systemctl', '--user', '--no-pager', '--full', 'status',
                             *SERVICES, 'bluefin-ai-models.service'], check=False)
    subprocess.run(prefix + ['podman', 'ps', '-a'], check=False)
    print('Service logs as ' + name + ': journalctl --user -b -u bluefin-runtime-controller.service '
          '-u bluefin-platform-bifrost.service -u bluefin-platform-webui.service '
          '-u bluefin-platform-edge.service --no-pager -n 100')
    print('Configured WebUI: http://127.0.0.1:3000 or http://<LAN-or-Tailscale-IP>:3000')
    print('Configured inference API: http://<host-IP>:8643/v1; credential file: ' + str(credential_path))
    print('Endpoint availability is not verified by this status command.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for action in ('validate', 'images', 'status', 'provision', 'prepare-models', 'stop-runtimes'):
        command = commands.add_parser(action)
        command.add_argument('--config', type=Path)
    internal = commands.add_parser('_remove-model-files', help=argparse.SUPPRESS)
    internal.add_argument('--profile', required=True)
    internal.add_argument('--purge-cache', action='store_true')
    models = commands.add_parser('models', help='Manage Hugging Face models as the rootless agent account')
    actions = models.add_subparsers(dest='model_action', required=True)
    for action in ('list', 'status', 'auto', 'unload', 'clear', 'inspect', 'plan', 'fetch', 'use', 'pin', 'remove'):
        command = actions.add_parser(action)
        if action in ('inspect', 'plan', 'fetch'):
            command.add_argument('source', help='Hugging Face owner/repository or exact file URL')
            command.add_argument('--revision')
            command.add_argument('--format', choices=('auto','gguf','safetensors'), default='auto')
            command.add_argument('--file', help='Exact GGUF filename; all its shards are included')
        if action in ('use', 'pin', 'remove'):
            command.add_argument('model', help='Installed model ID (models list) or local/general')
        if action in ('plan', 'fetch', 'use', 'pin'):
            command.add_argument('--runtime', choices=('auto','ramalama','llamacpp','strata','vllm'), default='auto')
            command.add_argument('--context', type=parse_context)
            command.add_argument('--memory-gib', type=int, help='Explicit resident memory budget when metadata is insufficient')
            command.add_argument('--force', action='store_true',
                                 help='Persistently override estimated-memory limits, including resident-weight estimates; measured OS reserve checks remain')
        if action == 'remove':
            command.add_argument('--purge-cache', action='store_true')
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if args.action == 'models':
            manage_models(args)
            return
        if args.action == '_remove-model-files':
            if os.environ.get('BLUEFIN_AI_MAINTENANCE') != '1':
                raise ValueError('Use bluefin-ai-platform models remove MODEL')
            run('bluefin-agent-user', 'require')
            config = effective_config()
            if args.profile not in config['profiles']:
                raise ValueError('Unknown catalog profile')
            with model_lock():
                model_manager(config).remove_files(args.profile, args.purge_cache)
            return
        if args.action == 'status':
            show_status()
            return
        if args.action == 'prepare-models':
            with model_lock():
                prepare_models()
            return
        manifest = ASSETS / 'Dockerfile'
        if args.config and (args.config.parent / 'Dockerfile').is_file():
            manifest = args.config.parent / 'Dockerfile'
        if args.action == 'images':
            print(json.dumps(image_catalog(manifest), indent=2))
            return
        if args.action == 'stop-runtimes':
            # Active units are loaded in systemd even if registry/config parsing
            # failed. Controller failure must not leave a dynamic engine running.
            run('systemctl', '--user', 'stop', 'bluefin-runtime-*.service')
            return
        config = validate(resolve_images(json.loads(args.config.read_text()), manifest)
                          if args.config else load())
        if args.action == 'validate':
            print('Valid platform configuration; enabled=' + str(config['enabled']))
        else:
            if config['enabled']:
                run('bluefin-agent-user', 'require')
                BASE.mkdir(mode=0o700, parents=True, exist_ok=True)
                with (BASE / 'provision.lock').open('a') as lock:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    provision(config)
            else:
                provision(config)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as exc:
        parser.exit(1, 'AI platform: ' + str(exc) + '\n')


if __name__ == '__main__':
    main()
