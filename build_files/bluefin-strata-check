#!/usr/bin/env python3
"""Check that the local Strata adapter returns actual model identifiers."""
import argparse
import http.client
import json
import re


def model_ids(port):
    if not re.fullmatch(r'[1-9][0-9]{0,4}', port) or int(port) > 65535:
        raise ValueError('invalid local port')
    connection = http.client.HTTPConnection('127.0.0.1', int(port), timeout=10)
    try:
        connection.request('GET', '/v1/models')
        response = connection.getresponse()
        if response.status != 200 or response.getheader('X-Bluefin-Strata-Adapter') != '1':
            raise ValueError('Strata adapter is not ready')
        result = json.loads(response.read(1048577))
        data = result.get('data') if isinstance(result, dict) else None
        if not isinstance(data, list) or not data or any(
                not isinstance(item, dict) or not isinstance(item.get('id'), str) or not item['id']
                for item in data):
            raise ValueError('Strata returned no usable model IDs')
        return [item['id'] for item in data]
    finally:
        connection.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('port')
    args = parser.parse_args()
    try:
        for model in model_ids(args.port):
            print(model)
    except (OSError, ValueError, http.client.HTTPException) as exc:
        parser.exit(1, f'Strata readiness check failed: {exc}\n')


if __name__ == '__main__':
    main()
