#!/usr/bin/env bash

set -euo pipefail

container_init() {
  install -Dm0644 /run/host/usr/share/bluefin-agent/npmrc /etc/npmrc
  ln -sfn /usr/bin/distrobox-host-exec /usr/local/bin/podman

  cat >/etc/profile.d/bluefin-agent.sh <<'EOF'
export NPM_CONFIG_GLOBALCONFIG=/etc/npmrc
export NPM_CONFIG_IGNORE_SCRIPTS=true
export NPM_CONFIG_STRICT_SSL=true
export HERMES_DOCKER_BINARY=podman
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --shell bash)"
fi
EOF

  cat >/usr/local/bin/agent-node <<'EOF'
#!/usr/bin/env bash
source /etc/profile.d/bluefin-agent.sh
exec node "$@"
EOF
  cat >/usr/local/bin/agent-npm <<'EOF'
#!/usr/bin/env bash
source /etc/profile.d/bluefin-agent.sh
exec npm "$@"
EOF
  cat >/usr/local/bin/agent-npx <<'EOF'
#!/usr/bin/env bash
source /etc/profile.d/bluefin-agent.sh
exec npx "$@"
EOF
  cat >/usr/local/bin/agent-openclaw <<'EOF'
#!/usr/bin/env bash
source /etc/profile.d/bluefin-agent.sh
exec openclaw "$@"
EOF
  cat >/usr/local/bin/agent-hermes <<'EOF'
#!/usr/bin/env bash
source /etc/profile.d/bluefin-agent.sh
exec "$HOME/.local/bin/hermes" "$@"
EOF
  chmod 0755 /usr/local/bin/agent-node /usr/local/bin/agent-npm /usr/local/bin/agent-npx /usr/local/bin/agent-openclaw /usr/local/bin/agent-hermes
}

install_node() {
  if ! command -v brew >/dev/null 2>&1; then
    export NONINTERACTIVE=1
    export CI=1
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  brew list fnm >/dev/null 2>&1 || brew install fnm
  eval "$(fnm env --shell bash)"
  fnm install 22
  fnm default 22

  install -Dm0644 /run/host/usr/share/bluefin-agent/npmrc "$HOME/.npmrc"
  echo "Node: $(node --version)"
  echo "npm:  $(npm --version)"
  echo "npm ignore-scripts: $(npm config get ignore-scripts)"
}

case "${1:-}" in
  --container-init)
    container_init
    ;;
  --install-node)
    install_node
    ;;
  *)
    echo "Usage: bluefin-agent-ubuntu-setup --container-init|--install-node" >&2
    exit 2
    ;;
esac
